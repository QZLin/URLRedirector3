{
  "name": "urlredirector3",
  "version": "1.4.0",
  "description": "Redirect URLs with regular expressions (Firefox WebExtension)",
  "homepage": "https://github.com/QZLin/URLRedirector3",
  "repository": {
    "type": "git",
    "url": "https://github.com/QZLin/URLRedirector3.git"
  },
  "author": {
    "name": "QZLin",
    "email": "QZLin@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "node build/dev.mjs",
    "build": "node build/build.mjs --prod",
    "build:dev": "node build/build.mjs",
    "build:offline": "node build/build.mjs --prod --variant=offline",
    "watch": "node build/build.mjs --watch",
    "start": "web-ext run --source-dir dist/firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:webext": "web-ext lint --source-dir dist/firefox",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test",
    "package": "pnpm run build && node build/package.mjs",
    "package:offline": "pnpm run build:offline && node build/package.mjs --variant=offline",
    "sign": "pnpm run build && node --env-file-if-exists=.env build/sign.mjs"
  },
  "publishConfig": {
    "firefox-webstore": "https://addons.mozilla.org/firefox/addon/urlredirector3/"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/jquery": "^3.5.33",
    "@types/jsdom": "^30.0.0",
    "bootstrap": "^3.4.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "jquery": "^3.7.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  }
}
