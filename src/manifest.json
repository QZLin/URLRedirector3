{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.0.0",
  "homepage_url": "https://github.com/fengyc/URLRedirector",
  "default_locale": "en",
  "icons": {
    "20": "static/images/r20.png",
    "25": "static/images/r25.png",
    "30": "static/images/r30.png",
    "48": "static/images/r48.png",
    "96": "static/images/r96.png",
    "128": "static/images/r128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "URLRedirector@fengyc",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["alarms", "storage", "tabs", "webRequest", "webRequestBlocking"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_icon": {
      "20": "static/images/r20.png",
      "25": "static/images/r25.png",
      "30": "static/images/r30.png",
      "40": "static/images/r40.png",
      "48": "static/images/r48.png"
    },
    "default_title": "URLRedirector",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "static/css/bootstrap.min.css",
        "static/css/bootstrap-theme.min.css",
        "static/fonts/*",
        "static/images/*",
        "static/js/jquery.js",
        "static/js/bootstrap.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
